<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand tokens: standards/BRAND_KIT.md §3 is the source of truth; ui/theme/BrandTokens.kt mirrors these. -->
    <color name="brand_blue">#4C8DFF</color>
    <color name="brand_violet">#8B5CF6</color>
    <color name="brand_ink">#0B0E14</color>
    <color name="surface">#161B26</color>
    <color name="surface_variant">#1F2633</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_muted">#9AA3B2</color>
    <color name="live_red">#FF3B47</color>
    <color name="error">#FF5A5F</color>

    <!-- Legacy names still referenced by themes.xml; they alias brand tokens so no off-brand hex remains. -->
    <color name="primary">@color/brand_ink</color>
    <color name="primary_dark">@color/brand_ink</color>
    <color name="primary_light">@color/surface_variant</color>
    <color name="secondary">@color/brand_blue</color>
    <color name="secondary_dark">@color/brand_violet</color>
    <color name="accent">@color/brand_blue</color>

    <color name="dark_bg">@color/brand_ink</color>
    <color name="dark_surface">@color/surface</color>
    <color name="dark_text">@color/text_primary</color>
    <color name="dark_text_secondary">@color/text_muted</color>

    <color name="light_bg">#FFFFFF</color>
    <color name="light_surface">#FFFFFF</color>
    <color name="light_text">@color/brand_ink</color>
    <color name="light_text_secondary">#B30B0E14</color>

    <!-- Physical remote colour-button hues, not brand colours. -->
    <color name="button_red">#CC0000</color>
    <color name="button_green">#00CC00</color>
    <color name="button_yellow">#FFFF00</color>
    <color name="button_blue">#0099FF</color>
</resources>
