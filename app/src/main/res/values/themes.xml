<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Freetia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:colorForeground">@color/light_text</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
    </style>

    <style name="Theme.Freetia.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:colorForeground">@color/dark_text</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
    </style>

    <!-- Launch theme: brand ink and logo tile so there is no white flash before Compose draws.
         installSplashScreen() in MainActivity swaps it for Theme.Freetia.Dark. -->
    <style name="Theme.Freetia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_blue</item>
        <item name="postSplashScreenTheme">@style/Theme.Freetia.Dark</item>
    </style>
</resources>
