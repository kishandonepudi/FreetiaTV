<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no longer stops device-to-device transfer. Exclude everything from both, so PIN
     hashes and playlist URLs (which can hold tokens) never leave the device (SECURITY_STANDARDS S4). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
